{
  "name": "@triadlabs/harness-sdk",
  "version": "0.1.0",
  "description": "A durable TypeScript SDK for building local Codex and Claude agent applications.",
  "type": "module",
  "license": "MIT",
  "author": "Triad Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Triad-Labs-Inc/harness-sdk.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Triad-Labs-Inc/harness-sdk#readme",
  "bugs": {
    "url": "https://github.com/Triad-Labs-Inc/harness-sdk/issues"
  },
  "keywords": [
    "agent",
    "codex",
    "claude",
    "electron",
    "harness",
    "sqlite"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./codex": {
      "types": "./dist/codex/index.d.ts",
      "import": "./dist/codex/index.js"
    },
    "./claude": {
      "types": "./dist/claude/index.d.ts",
      "import": "./dist/claude/index.js"
    },
    "./testkit": {
      "types": "./dist/testkit/index.d.ts",
      "import": "./dist/testkit/index.js"
    },
    "./testkit/vitest": {
      "types": "./dist/testkit/vitest.d.ts",
      "import": "./dist/testkit/vitest.js"
    }
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.226",
    "cross-spawn": "7.0.6"
  },
  "peerDependencies": {
    "vitest": "4.1.10"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "npm --prefix ../.. run build:package"
  }
}
