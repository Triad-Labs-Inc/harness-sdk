{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "linden",
  "name": "Harness SDK",
  "description": "Build local Codex and Claude agent applications with durable sessions, streaming events, permissions, and SQLite recovery.",
  "colors": {
    "primary": "#065F46",
    "light": "#4ADDB8",
    "dark": "#08705E"
  },
  "logo": {
    "light": "/assets/logo-light.svg",
    "dark": "/assets/logo-dark.svg",
    "href": "/"
  },
  "favicon": "/assets/favicon.svg",
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "family": "IBM Plex Sans",
    "heading": {
      "family": "IBM Plex Mono"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#F5F8F6",
      "dark": "#08110F"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "vesper"
      }
    }
  },
  "contextual": {
    "options": ["copy", "chatgpt", "claude"]
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/Triad-Labs-Inc/harness-sdk"
      },
      {
        "label": "npm",
        "href": "https://www.npmjs.com/package/@triadlabs/harness-sdk"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Install v0.1.0",
      "href": "/getting-started/installation"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Triad-Labs-Inc/harness-sdk"
    }
  },
  "redirects": [
    {
      "source": "/introduction",
      "destination": "/"
    },
    {
      "source": "/installation",
      "destination": "/getting-started/installation"
    },
    {
      "source": "/quickstart",
      "destination": "/getting-started/quickstart"
    },
    {
      "source": "/concepts/harness",
      "destination": "/getting-started/core-concepts"
    },
    {
      "source": "/concepts/sessions-and-turns",
      "destination": "/guides/sessions-and-turns"
    },
    {
      "source": "/concepts/events",
      "destination": "/guides/streaming-and-history"
    },
    {
      "source": "/concepts/interactions",
      "destination": "/guides/permissions-and-input"
    },
    {
      "source": "/guides/building-a-tui",
      "destination": "/guides/tui"
    },
    {
      "source": "/guides/building-an-electron-app",
      "destination": "/guides/electron"
    },
    {
      "source": "/guides/handling-permissions",
      "destination": "/guides/permissions-and-input"
    },
    {
      "source": "/guides/crash-recovery",
      "destination": "/guides/recovery"
    },
    {
      "source": "/guides/custom-adapters",
      "destination": "/reference/provider-adapter"
    },
    {
      "source": "/storage/overview",
      "destination": "/reference/storage"
    },
    {
      "source": "/storage/sqlite",
      "destination": "/reference/storage"
    },
    {
      "source": "/storage/migration",
      "destination": "/guides/recovery"
    },
    {
      "source": "/api/harness",
      "destination": "/reference/harness"
    },
    {
      "source": "/api/provider-codex",
      "destination": "/providers/codex"
    },
    {
      "source": "/api/provider-claude",
      "destination": "/providers/claude"
    },
    {
      "source": "/api/testkit",
      "destination": "/testing/fake-provider"
    },
    {
      "source": "/api/types/events",
      "destination": "/reference/events"
    },
    {
      "source": "/api/types/errors",
      "destination": "/reference/errors"
    },
    {
      "source": "/api/types/session",
      "destination": "/reference/harness"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Start here",
            "icon": "rocket",
            "pages": [
              "index",
              "getting-started/installation",
              "getting-started/quickstart",
              "getting-started/core-concepts"
            ]
          },
          {
            "group": "Providers",
            "icon": "bot",
            "pages": ["providers/overview", "providers/codex", "providers/claude"]
          },
          {
            "group": "Build your application",
            "icon": "workflow",
            "pages": [
              "guides/sessions-and-turns",
              "guides/streaming-and-history",
              "guides/permissions-and-input",
              "guides/tui",
              "guides/electron",
              "guides/recovery",
              "guides/security"
            ]
          },
          {
            "group": "Testing",
            "icon": "test-tube-2",
            "pages": ["testing/fake-provider", "testing/contract-suites"]
          },
          {
            "group": "Migration",
            "icon": "package-check",
            "pages": ["migration/package-consolidation"]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "braces",
        "groups": [
          {
            "group": "Core",
            "pages": [
              "reference/harness",
              "reference/events",
              "reference/errors",
              "reference/storage"
            ]
          },
          {
            "group": "Extensions",
            "pages": ["reference/provider-adapter"]
          }
        ]
      },
      {
        "tab": "GitHub",
        "icon": "github",
        "href": "https://github.com/Triad-Labs-Inc/harness-sdk"
      }
    ]
  }
}
